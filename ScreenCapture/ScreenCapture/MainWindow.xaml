<Window x:Class="ScreenCaptureWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Screen Capture" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="White">
            <TextBlock Text="Time step (sec):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TimeStepTextBox" Text="10" Width="50" VerticalAlignment="Center"/>

            <Button Content="Start" Click="StartButton_Click" Margin="15,0,0,0" Width="75" Padding="5"/>
            <Button Content="Stop" Click="StopButton_Click" Margin="10,0,0,0" Width="75" Padding="5"/>
            <Button Content="Exit" Click="ExitButton_Click" Margin="10,0,0,0" Width="75" Padding="5"/>
        </StackPanel>

        <!-- Image Display (Replaces PictureBox) -->
        <Image x:Name="CaptureImage" Grid.Row="1" Margin="10" Stretch="Uniform"/>

        <!-- Status Bar -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="Ready." Margin="10" Foreground="Gray"/>
    </Grid>
</Window>